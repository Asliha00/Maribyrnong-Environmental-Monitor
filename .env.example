# =====================================================================
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Generate passwords/keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Each team member keeps their own .env; share secrets via a password manager, not chat/email.
# On Vercel, set the backend values under Project -> Settings -> Environment Variables
# (separate values for Preview and Production). Pipeline/backup/owner URLs never go to Vercel.
# =====================================================================

# --- Neon database (see database/README.md) ---
# Pooled host (...-pooler.ap-southeast-2.aws.neon.tech): the FastAPI backend on Vercel
APP_DATABASE_URL=postgresql://app_user:PASSWORD@ep-YOUR-ENDPOINT-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
# Direct host (no -pooler): the data pipeline. Leave empty to work offline against local SQLite.
PIPELINE_DATABASE_URL=postgresql://pipeline_user:PASSWORD@ep-YOUR-ENDPOINT.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
# Direct host: nightly backup job and verify_security.py
BACKUP_DATABASE_URL=postgresql://backup_user:PASSWORD@ep-YOUR-ENDPOINT.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
BACKUP_ENCRYPTION_KEY=
# Owner role: ONLY for running database/*.sql and the owner check in verify_security.py
OWNER_DATABASE_URL=

# --- Private Vercel Blob store for the original council CSVs ---
# On Vercel the SDK uses OIDC automatically; this token is for laptops and GitHub Actions.
# SERVER-SIDE ONLY: never in frontend code, screenshots or the demo video.
BLOB_READ_WRITE_TOKEN=
RAW_BLOB_PREFIX=raw/

# --- Backend (FastAPI) ---
JWT_SECRET=
MFA_ENCRYPTION_KEY=            # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=development        # production enables Secure cookies and strict settings
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
